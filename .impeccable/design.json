      "css": ".ds-nav{background:var(--navy,#13182b);padding:16px;display:flex;flex-direction:column;gap:6px}.ds-repo{font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;display:block;width:100%;min-height:65px;text-align:left;border:0;border-radius:8px;padding:13px 12px;background:transparent;color:#aeb6d0;cursor:pointer;transition:background-color .15s ease,color .15s ease}.ds-repo strong{display:block;font-size:13px;font-weight:560}.ds-repo small{display:block;font-size:12px;margin-top:7px;color:#a3abc1}.ds-repo:hover{background:#20263d;color:white}.ds-repo.ds-active{background:#2e294c;color:#d4ccff}.ds-repo:focus-visible{outline:3px solid #9a8bf3;outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-url,.ds-primary,.ds-add,.ds-repo,.ds-secondary,.ds-tabs{transition:none!important;animation:none!important}}"
