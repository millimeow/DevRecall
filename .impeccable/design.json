      "css": ".ds-primary{font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;font-size:12px;display:inline-flex;align-items:center;justify-content:center;gap:8px;height:38px;padding:0 14px;border:0;border-radius:7px;font-weight:560;cursor:pointer;transition:background-color .15s ease,color .15s ease;background:var(--accent,#6554d9);color:white}.ds-primary:hover:not(:disabled){background:#5442c5}.ds-primary:focus-visible{outline:3px solid #9a8bf3;outline-offset:4px;}.ds-primary:disabled{cursor:not-allowed;opacity:.55;transition:none}@media(prefers-reduced-motion:reduce){.ds-url,.ds-primary,.ds-add,.ds-repo,.ds-secondary,.ds-tabs{transition:none!important;animation:none!important}}"
