      "css": ".ds-label{font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;font-size:12px;color:#555e73;font-weight:600}.ds-url{display:flex;border:1px solid #dddfea;border-radius:8px;padding:12px 13px;margin-top:9px;background:#fdfdff}.ds-url:focus-within{border-color:#a090db;box-shadow:0 0 0 3px #6554d908}.ds-url input{font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;font-size:12px;width:100%;min-width:0;border:0;outline:none;background:transparent;color:#5a6077;caret-color:var(--accent,#6554d9)}.ds-url input::placeholder{color:#626b80}.ds-url.ds-invalid{border-color:#d38d9a}@media(prefers-reduced-motion:reduce){.ds-url,.ds-primary,.ds-add,.ds-repo,.ds-secondary,.ds-tabs{transition:none!important;animation:none!important}}"
