{
  "name": "devrecall",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "python -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload",
    "dev:frontend": "npm run dev --workspace frontend",
    "start:backend": "python -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000",
    "start:frontend": "npm start --workspace frontend",
    "build": "npm run build --workspace frontend",
    "test": "python -m pytest backend/tests",
    "test:legacy": "npm test --workspace backend",
    "evaluate:legacy": "node backend/scripts/evaluate-discussion.js",
    "evaluate": "python backend/scripts/evaluate_discussion.py"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
