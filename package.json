{
  "name": "devrecall",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web 'npm run dev -w server' 'npm run dev -w web'",
    "test": "vitest run",
    "lint": "eslint server web && npm run typecheck -w server && npm run typecheck -w web",
    "build": "npm run build -w server && npm run build -w web",
    "start": "npm start -w server",
    "test:e2e": "playwright test",
    "eval:pep": "tsx scripts/evaluate-pep.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.19.0",
    "ajv": "^8.20.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
