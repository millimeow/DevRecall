PORT=3001
HOST=127.0.0.1
# Absolute path optional. Default is project-root/data/devrecall.db, independent of cwd.
DATABASE_PATH=
# Optional public read-only GitHub token, server only. Never use VITE_ for secrets.
GITHUB_TOKEN=
# Leave unset until you select and install an open-weight model.
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=http://127.0.0.1:11434
AI_API_KEY=
# ollama or openai-compatible. The latter supports self-hosted vLLM / llama.cpp.
AI_TIMEOUT_MS=120000
AI_CONTEXT_CHARS=24000
# Optional Ollama memory/output controls. Suggested starting point for a 16 GB Mac:
# AI_CONTEXT_CHARS=10000
# AI_NUM_CTX=8192
# AI_NUM_PREDICT=3072
# AI_THINK=true
# AI_EXTRACTION_THINK=false
